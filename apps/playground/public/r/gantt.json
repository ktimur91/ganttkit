{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "gantt",
  "title": "Gantt",
  "description": "Gantt chart with virtual scrolling, drag and drop, dependencies and zoom. Built on the headless ganttkit core.",
  "dependencies": [
    "ganttkit@^0.2.0"
  ],
  "files": [
    {
      "path": "registry/gantt/Gantt.vue",
      "content": "<script setup lang=\"ts\" generic=\"R extends GanttRowBase, I extends GanttItemBase = R & GanttItemBase\">\nimport {\n  type DateInput,\n  type GanttBarState,\n  type GanttEditable,\n  type GanttItemBase,\n  type GanttLink,\n  type GanttRowBase,\n  type GanttRowState,\n  type ItemChange,\n  type SnapUnit,\n  type WorkingCalendar,\n  type ZoomLevel,\n  useGantt,\n} from 'ganttkit'\nimport { type HTMLAttributes, provide, ref, useId } from 'vue'\nimport { cn } from '@/lib/utils'\nimport { type GanttContext, GanttContextKey } from './context'\nimport GanttBar from './GanttBar.vue'\nimport GanttGrid from './GanttGrid.vue'\nimport GanttLinks from './GanttLinks.vue'\nimport GanttRowLabel from './GanttRowLabel.vue'\nimport GanttTimescale from './GanttTimescale.vue'\nimport GanttToday from './GanttToday.vue'\n\nconst props = withDefaults(\n  defineProps<{\n    rows: readonly R[]\n    /** Omit for \"one task per row\": rows with `start` and `end` become bars. */\n    items?: readonly I[]\n    links?: readonly GanttLink[]\n    timeZone?: string\n    locale?: string\n    rowHeight?: number\n    sidebarWidth?: number\n    editable?: boolean | Partial<GanttEditable>\n    isItemEditable?: (item: I) => boolean\n    /** Working days and holidays: edits keep lengths in working days and skip days off. */\n    calendar?: WorkingCalendar\n    snap?: SnapUnit\n    range?: { start: DateInput; end: DateInput }\n    weekStartsOn?: number\n    /** Date centered when the chart first gets a size. Defaults to today, `null` keeps the start. */\n    initialDate?: DateInput | null\n    class?: HTMLAttributes['class']\n  }>(),\n  { rowHeight: 36, sidebarWidth: 280, editable: true },\n)\n\nconst zoom = defineModel<ZoomLevel>('zoom', { default: 'week' })\n\nconst emit = defineEmits<{\n  'update:rows': [rows: R[]]\n  'update:items': [items: I[]]\n  'update:links': [links: GanttLink[]]\n  'item-change': [change: ItemChange<I>]\n  'item-click': [item: I]\n  'link-create': [link: GanttLink]\n  'link-delete': [link: GanttLink]\n}>()\n\ndefineSlots<{\n  'sidebar-header'?: () => unknown\n  row?: (props: GanttRowState<R>) => unknown\n  bar?: (props: GanttBarState<I>) => unknown\n  timeline?: () => unknown\n}>()\n\nconst HEADER_HEIGHT = 56\n\nconst gantt = useGantt<R, I>({\n  rows: () => props.rows,\n  items: () => props.items,\n  links: () => props.links,\n  timeZone: () => props.timeZone,\n  locale: () => props.locale,\n  zoom,\n  rowHeight: () => props.rowHeight,\n  sidebarWidth: () => props.sidebarWidth,\n  headerHeight: HEADER_HEIGHT,\n  editable: () => props.editable,\n  isItemEditable: props.isItemEditable,\n  calendar: () => props.calendar,\n  snap: () => props.snap,\n  range: () => props.range,\n  weekStartsOn: props.weekStartsOn,\n  initialDate: () => props.initialDate,\n  onItemChange(change) {\n    emit('item-change', change)\n    const replace = <T,>(list: readonly T[]) =>\n      list.map((entry) =>\n        entry === (change.item as unknown) ? { ...entry, start: change.start, end: change.end } : entry,\n      )\n    if (props.items) emit('update:items', replace(props.items))\n    else emit('update:rows', replace(props.rows))\n  },\n  onLinkCreate(draft) {\n    const link: GanttLink = { id: `${draft.from}:${draft.to}`, ...draft }\n    emit('link-create', link)\n    emit('update:links', [...(props.links ?? []), link])\n  },\n})\n\nconst hoveredRowId = ref<string | null>(null)\nconst selectedItemId = ref<string | null>(null)\nconst selectedLinkId = ref<string | null>(null)\n\nprovide(GanttContextKey, {\n  ...(gantt as unknown as GanttContext),\n  uid: useId(),\n  hoveredRowId,\n  selectedItemId,\n  selectedLinkId,\n})\n\nconst { viewportEl, totalWidth, totalHeight, visibleRows, visibleBars } = gantt\n\nfunction zoomAt(clientX: number, direction: 'in' | 'out') {\n  const box = viewportEl.value!.getBoundingClientRect()\n  const anchor = clientX - box.left - props.sidebarWidth\n  if (direction === 'in') gantt.zoomIn(anchor)\n  else gantt.zoomOut(anchor)\n}\n\n// Ctrl/Cmd + wheel (and trackpad pinch in Chrome and Firefox) zooms around the pointer.\nlet wheelDelta = 0\nfunction onWheel(event: WheelEvent) {\n  if (!event.ctrlKey && !event.metaKey) return\n  event.preventDefault()\n  // Firefox reports mouse wheels in lines, not pixels.\n  const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? viewportEl.value!.clientHeight : 1\n  wheelDelta += event.deltaY * unit\n  if (Math.abs(wheelDelta) < 40) return\n  zoomAt(event.clientX, wheelDelta < 0 ? 'in' : 'out')\n  wheelDelta = 0\n}\n\n// Safari sends trackpad pinch as gesture events, without them it zooms the whole page.\nlet gestureScale = 1\nfunction onGestureStart(event: Event) {\n  event.preventDefault()\n  gestureScale = 1\n}\nfunction onGestureChange(event: Event) {\n  event.preventDefault()\n  const { scale, clientX } = event as Event & { scale: number; clientX: number }\n  if (scale / gestureScale > 1.25) {\n    zoomAt(clientX, 'in')\n    gestureScale = scale\n  } else if (scale / gestureScale < 0.8) {\n    zoomAt(clientX, 'out')\n    gestureScale = scale\n  }\n}\n\nfunction onKeydown(event: KeyboardEvent) {\n  if ((event.key === 'Delete' || event.key === 'Backspace') && selectedLinkId.value && props.links) {\n    const link = props.links.find((l) => String(l.id) === selectedLinkId.value)\n    if (!link) return\n    event.preventDefault()\n    selectedLinkId.value = null\n    emit('link-delete', link)\n    emit('update:links', props.links.filter((l) => l !== link))\n  }\n}\n\nfunction onBarClick(bar: GanttBarState<I>) {\n  selectedItemId.value = bar.id\n  selectedLinkId.value = null\n  emit('item-click', bar.item)\n}\n\ndefineExpose({ gantt })\n</script>\n\n<template>\n  <div\n    ref=\"viewportEl\"\n    data-slot=\"gantt\"\n    :class=\"cn('relative overflow-auto overscroll-contain bg-background text-sm text-foreground', props.class)\"\n    tabindex=\"-1\"\n    @wheel=\"onWheel\"\n    @gesturestart=\"onGestureStart\"\n    @gesturechange=\"onGestureChange\"\n    @keydown=\"onKeydown\"\n  >\n    <div\n      class=\"relative\"\n      :style=\"{ width: `${sidebarWidth + totalWidth}px`, height: `${HEADER_HEIGHT + totalHeight}px` }\"\n    >\n      <div class=\"sticky top-0 z-30 flex border-b bg-background\" :style=\"{ height: `${HEADER_HEIGHT}px` }\">\n        <div\n          class=\"sticky left-0 z-10 flex shrink-0 items-end border-r bg-background\"\n          :style=\"{ width: `${sidebarWidth}px` }\"\n        >\n          <slot name=\"sidebar-header\">\n            <div class=\"px-3 pb-2 text-xs font-medium text-muted-foreground\">Name</div>\n          </slot>\n        </div>\n        <GanttTimescale class=\"shrink-0\" :style=\"{ width: `${totalWidth}px` }\" />\n      </div>\n\n      <div class=\"flex\">\n        <div\n          class=\"sticky left-0 z-20 shrink-0 border-r bg-background\"\n          :style=\"{ width: `${sidebarWidth}px`, height: `${totalHeight}px` }\"\n        >\n          <div\n            v-for=\"row in visibleRows\"\n            :key=\"row.id\"\n            class=\"absolute inset-x-0 top-0 border-b border-border/60\"\n            :class=\"hoveredRowId === row.id && 'bg-muted/50'\"\n            :style=\"{ height: `${rowHeight}px`, transform: `translateY(${row.top}px)` }\"\n            @mouseenter=\"hoveredRowId = row.id\"\n            @mouseleave=\"hoveredRowId = null\"\n          >\n            <slot name=\"row\" v-bind=\"row\">\n              <GanttRowLabel :row=\"row\" />\n            </slot>\n          </div>\n        </div>\n\n        <div class=\"relative shrink-0 overflow-hidden\" :style=\"{ width: `${totalWidth}px`, height: `${totalHeight}px` }\">\n          <GanttGrid />\n          <slot name=\"timeline\" />\n          <GanttToday />\n          <GanttLinks />\n          <GanttBar\n            v-for=\"bar in visibleBars\"\n            :key=\"bar.id\"\n            :bar=\"bar\"\n            @select=\"onBarClick(bar)\"\n          >\n            <template v-if=\"$slots.bar\" #default>\n              <slot name=\"bar\" v-bind=\"bar\" />\n            </template>\n          </GanttBar>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/GanttBar.vue",
      "content": "<script setup lang=\"ts\">\nimport type { GanttBarState, GanttItemBase } from 'ganttkit'\nimport { computed } from 'vue'\nimport { cn } from '@/lib/utils'\nimport { useGanttContext } from './context'\n\ntype BarItem = GanttItemBase & {\n  name?: string\n  title?: string\n  progress?: number\n  color?: string\n  type?: string\n}\n\nconst props = defineProps<{ bar: GanttBarState<BarItem> }>()\nconst emit = defineEmits<{ select: [] }>()\n\nconst { startDrag, startLink, nudge, editable, selectedItemId } = useGanttContext()\n\nconst item = computed(() => props.bar.item)\nconst label = computed(() => item.value.name ?? item.value.title ?? '')\nconst summary = computed(() => item.value.type === 'summary')\nconst progress = computed(() => Math.min(1, Math.max(0, item.value.progress ?? 0)))\nconst selected = computed(() => selectedItemId.value === props.bar.id)\n// Narrow bars show their label outside, to the right.\nconst labelOutside = computed(() => props.bar.milestone || props.bar.width < 56)\nconst canMove = computed(() => props.bar.editable && editable.value.move)\nconst canResize = computed(() => props.bar.editable && editable.value.resize && !props.bar.milestone)\nconst canLink = computed(() => props.bar.editable && editable.value.link)\n\nfunction onKeydown(event: KeyboardEvent) {\n  const steps = event.key === 'ArrowLeft' ? -1 : event.key === 'ArrowRight' ? 1 : 0\n  if (steps) {\n    event.preventDefault()\n    nudge(props.bar.id, event.shiftKey ? 'resize-end' : 'move', steps)\n  } else if (event.key === 'Enter' || event.key === ' ') {\n    event.preventDefault()\n    emit('select')\n  }\n}\n</script>\n\n<template>\n  <div\n    :data-gantt-item=\"bar.id\"\n    role=\"button\"\n    tabindex=\"0\"\n    :aria-label=\"label\"\n    :aria-pressed=\"selected\"\n    :class=\"\n      cn(\n        'group absolute top-0 left-0 touch-none outline-none select-none',\n        canMove && 'cursor-grab',\n        bar.dragging && 'z-10 cursor-grabbing',\n      )\n    \"\n    :style=\"{\n      width: `${bar.width}px`,\n      height: `${bar.height}px`,\n      transform: `translate(${bar.x}px, ${bar.y}px)`,\n    }\"\n    @pointerdown=\"startDrag($event, bar.id, 'move')\"\n    @click=\"emit('select')\"\n    @keydown=\"onKeydown\"\n  >\n    <div\n      v-if=\"bar.milestone\"\n      class=\"size-full scale-[0.72] rotate-45 rounded-[3px] bg-primary group-focus-visible:ring-2 group-focus-visible:ring-ring\"\n      :class=\"selected && 'ring-2 ring-ring ring-offset-1 ring-offset-background'\"\n      :style=\"item.color ? { backgroundColor: item.color } : undefined\"\n    />\n    <div\n      v-else-if=\"summary\"\n      class=\"absolute inset-x-0 top-1/2 h-2 -translate-y-1/2 rounded-[2px] bg-foreground/70\"\n    />\n    <div\n      v-else\n      :class=\"\n        cn(\n          'relative flex size-full items-center overflow-hidden rounded-md bg-primary text-primary-foreground shadow-xs transition-shadow',\n          'group-focus-visible:ring-2 group-focus-visible:ring-ring group-focus-visible:ring-offset-1 group-focus-visible:ring-offset-background',\n          selected && 'ring-2 ring-ring ring-offset-1 ring-offset-background',\n          bar.dragging && 'shadow-lg',\n        )\n      \"\n      :style=\"item.color ? { backgroundColor: item.color } : undefined\"\n    >\n      <div\n        v-if=\"progress > 0\"\n        class=\"absolute bottom-0 left-0 h-[3px] bg-primary-foreground/60\"\n        :style=\"{ width: `${progress * 100}%` }\"\n      />\n      <span v-if=\"!labelOutside\" class=\"relative truncate px-2 text-xs\">\n        <slot>{{ label }}</slot>\n      </span>\n    </div>\n\n    <!-- Offset past the link elbow (12px), so outgoing links do not cross the label. -->\n    <span\n      v-if=\"labelOutside && label\"\n      class=\"pointer-events-none absolute top-1/2 left-full ml-5 -translate-y-1/2 text-xs whitespace-nowrap text-muted-foreground\"\n      :class=\"summary && 'font-medium text-foreground'\"\n    >\n      <slot>{{ label }}</slot>\n    </span>\n\n    <template v-if=\"canResize\">\n      <div\n        class=\"absolute inset-y-0 left-0 w-2 cursor-ew-resize\"\n        @pointerdown=\"startDrag($event, bar.id, 'resize-start')\"\n      />\n      <div\n        class=\"absolute inset-y-0 right-0 w-2 cursor-ew-resize\"\n        @pointerdown=\"startDrag($event, bar.id, 'resize-end')\"\n      />\n    </template>\n\n    <template v-if=\"canLink && !bar.dragging\">\n      <button\n        v-for=\"side in ['start', 'end'] as const\"\n        :key=\"side\"\n        type=\"button\"\n        tabindex=\"-1\"\n        :aria-label=\"side === 'start' ? 'Link from start' : 'Link from end'\"\n        :class=\"\n          cn(\n            'absolute top-1/2 size-3 -translate-y-1/2 cursor-crosshair rounded-full border-2 border-primary bg-background opacity-0 transition-opacity group-hover:opacity-100',\n            side === 'start' ? '-left-4' : '-right-4',\n          )\n        \"\n        @pointerdown=\"startLink($event, bar.id, side)\"\n      />\n    </template>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/GanttGrid.vue",
      "content": "<script setup lang=\"ts\">\nimport { useGanttContext } from './context'\n\nconst { ticks, nonWorkingDays, visibleRows, rowHeight, windowRect, hoveredRowId } = useGanttContext()\n</script>\n\n<template>\n  <div class=\"pointer-events-none absolute inset-0\" aria-hidden=\"true\">\n    <div\n      v-for=\"day in nonWorkingDays\"\n      :key=\"day.key\"\n      class=\"absolute bg-muted/50\"\n      :style=\"{ left: `${day.x}px`, width: `${day.width}px`, top: `${windowRect.y}px`, height: `${windowRect.height}px` }\"\n    />\n    <div\n      v-for=\"tick in ticks.bottom\"\n      :key=\"tick.key\"\n      class=\"absolute w-px bg-border/60\"\n      :style=\"{ left: `${tick.x}px`, top: `${windowRect.y}px`, height: `${windowRect.height}px` }\"\n    />\n  </div>\n  <div\n    v-for=\"row in visibleRows\"\n    :key=\"row.id\"\n    class=\"absolute border-b border-border/60\"\n    :class=\"hoveredRowId === row.id && 'bg-muted/50'\"\n    :style=\"{\n      left: `${windowRect.x}px`,\n      width: `${windowRect.width}px`,\n      height: `${rowHeight}px`,\n      transform: `translateY(${row.top}px)`,\n    }\"\n    @mouseenter=\"hoveredRowId = row.id\"\n    @mouseleave=\"hoveredRowId = null\"\n  />\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/GanttLinks.vue",
      "content": "<script setup lang=\"ts\">\nimport { useGanttContext } from './context'\n\nconst { visibleLinks, linkDraft, windowRect, uid, selectedLinkId, selectedItemId } = useGanttContext()\n\nconst marker = (state: 'default' | 'violated' | 'selected') => `${uid}-arrow-${state}`\n\nfunction select(id: string) {\n  selectedLinkId.value = id\n  selectedItemId.value = null\n}\n</script>\n\n<template>\n  <!-- The SVG only covers the rendered window, paths use timeline coordinates via viewBox. -->\n  <svg\n    class=\"pointer-events-none absolute overflow-visible\"\n    :style=\"{\n      left: `${windowRect.x}px`,\n      top: `${windowRect.y}px`,\n      width: `${windowRect.width}px`,\n      height: `${windowRect.height}px`,\n    }\"\n    :viewBox=\"`${windowRect.x} ${windowRect.y} ${windowRect.width || 1} ${windowRect.height || 1}`\"\n  >\n    <defs>\n      <marker\n        v-for=\"state in ['default', 'violated', 'selected'] as const\"\n        :id=\"marker(state)\"\n        :key=\"state\"\n        viewBox=\"0 0 8 8\"\n        refX=\"7\"\n        refY=\"4\"\n        markerWidth=\"8\"\n        markerHeight=\"8\"\n        markerUnits=\"userSpaceOnUse\"\n        orient=\"auto\"\n      >\n        <path\n          d=\"M0,0 L8,4 L0,8 z\"\n          :class=\"{\n            'fill-muted-foreground': state === 'default',\n            'fill-destructive': state === 'violated',\n            'fill-primary': state === 'selected',\n          }\"\n        />\n      </marker>\n    </defs>\n\n    <g\n      v-for=\"link in visibleLinks\"\n      :key=\"link.id\"\n      class=\"pointer-events-auto cursor-pointer\"\n      @click.stop=\"select(link.id)\"\n    >\n      <path :d=\"link.path\" class=\"fill-none stroke-transparent\" stroke-width=\"10\" />\n      <path\n        :d=\"link.path\"\n        class=\"fill-none\"\n        :class=\"\n          selectedLinkId === link.id\n            ? 'stroke-primary'\n            : link.violated\n              ? 'stroke-destructive'\n              : 'stroke-muted-foreground/70'\n        \"\n        :stroke-width=\"selectedLinkId === link.id ? 2 : 1.25\"\n        :marker-end=\"`url(#${marker(selectedLinkId === link.id ? 'selected' : link.violated ? 'violated' : 'default')})`\"\n      />\n    </g>\n\n    <line\n      v-if=\"linkDraft\"\n      :x1=\"linkDraft.x1\"\n      :y1=\"linkDraft.y1\"\n      :x2=\"linkDraft.x2\"\n      :y2=\"linkDraft.y2\"\n      class=\"stroke-primary\"\n      stroke-width=\"1.5\"\n      stroke-dasharray=\"4 3\"\n    />\n  </svg>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/GanttRowLabel.vue",
      "content": "<script setup lang=\"ts\">\nimport type { GanttRowState } from 'ganttkit'\nimport { computed } from 'vue'\nimport { useGanttContext } from './context'\n\nconst props = defineProps<{ row: GanttRowState<{ id: string | number; name?: string; title?: string }> }>()\n\nconst { toggleRow } = useGanttContext()\n\nconst label = computed(() => props.row.row.name ?? props.row.row.title ?? String(props.row.row.id))\n</script>\n\n<template>\n  <div class=\"flex h-full items-center gap-1 pr-3\" :style=\"{ paddingLeft: `${8 + row.depth * 16}px` }\">\n    <button\n      v-if=\"row.hasChildren\"\n      type=\"button\"\n      class=\"flex size-5 shrink-0 items-center justify-center rounded-sm text-muted-foreground hover:bg-accent hover:text-accent-foreground\"\n      :aria-label=\"row.expanded ? 'Collapse' : 'Expand'\"\n      :aria-expanded=\"row.expanded\"\n      @click=\"toggleRow(row.id)\"\n    >\n      <svg\n        class=\"size-3.5 transition-transform\"\n        :class=\"row.expanded && 'rotate-90'\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n      >\n        <path d=\"m9 18 6-6-6-6\" />\n      </svg>\n    </button>\n    <span v-else class=\"w-5 shrink-0\" />\n    <span class=\"truncate\" :class=\"row.hasChildren && 'font-medium'\">{{ label }}</span>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/GanttTimescale.vue",
      "content": "<script setup lang=\"ts\">\nimport { useGanttContext } from './context'\n\nconst { ticks, sidebarWidth } = useGanttContext()\n</script>\n\n<template>\n  <div class=\"relative select-none text-xs\">\n    <div class=\"absolute inset-x-0 top-0 h-1/2 border-b\">\n      <div\n        v-for=\"tick in ticks.top\"\n        :key=\"tick.key\"\n        class=\"absolute inset-y-0 border-l\"\n        :style=\"{ left: `${tick.x}px`, width: `${tick.width}px` }\"\n      >\n        <!-- Sticky label: the current month stays readable while scrolling through it. -->\n        <span\n          class=\"sticky inline-block truncate px-2 leading-7 font-medium\"\n          :style=\"{ left: `${sidebarWidth}px`, maxWidth: `${tick.width}px` }\"\n        >\n          {{ tick.label }}\n        </span>\n      </div>\n    </div>\n    <div class=\"absolute inset-x-0 bottom-0 h-1/2\">\n      <div\n        v-for=\"tick in ticks.bottom\"\n        :key=\"tick.key\"\n        class=\"absolute inset-y-0 flex items-center justify-center gap-1 overflow-hidden border-l text-muted-foreground\"\n        :class=\"tick.nonWorking && 'text-muted-foreground/60'\"\n        :style=\"{ left: `${tick.x}px`, width: `${tick.width}px` }\"\n      >\n        <span v-if=\"tick.sublabel\" class=\"text-[10px] uppercase opacity-70\">{{ tick.sublabel }}</span>\n        <span class=\"truncate\">{{ tick.label }}</span>\n      </div>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/GanttToday.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from 'vue'\nimport { useGanttContext } from './context'\n\nconst { timeToX, totalWidth, windowRect } = useGanttContext()\n\nconst x = computed(() => timeToX(Date.now()))\n</script>\n\n<template>\n  <div\n    v-if=\"x >= 0 && x <= totalWidth\"\n    class=\"pointer-events-none absolute w-px bg-primary/50\"\n    :style=\"{ left: `${x}px`, top: `${windowRect.y}px`, height: `${windowRect.height}px` }\"\n    aria-hidden=\"true\"\n  />\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/context.ts",
      "content": "import type { GanttInstance } from 'ganttkit'\nimport { type InjectionKey, type Ref, inject } from 'vue'\n\nexport interface GanttContext extends GanttInstance {\n  /** Prefix for SVG ids, unique per chart. */\n  uid: string\n  hoveredRowId: Ref<string | null>\n  selectedItemId: Ref<string | null>\n  selectedLinkId: Ref<string | null>\n}\n\nexport const GanttContextKey: InjectionKey<GanttContext> = Symbol('GanttContext')\n\nexport function useGanttContext(): GanttContext {\n  const context = inject(GanttContextKey)\n  if (!context) throw new Error('Gantt parts must be used inside <Gantt>')\n  return context\n}\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/index.ts",
      "content": "export { default as Gantt } from './Gantt.vue'\nexport { default as GanttBar } from './GanttBar.vue'\nexport { default as GanttGrid } from './GanttGrid.vue'\nexport { default as GanttLinks } from './GanttLinks.vue'\nexport { default as GanttRowLabel } from './GanttRowLabel.vue'\nexport { default as GanttTimescale } from './GanttTimescale.vue'\nexport { default as GanttToday } from './GanttToday.vue'\nexport { type GanttContext, GanttContextKey, useGanttContext } from './context'\n",
      "type": "registry:ui"
    }
  ],
  "type": "registry:ui"
}
