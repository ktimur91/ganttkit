{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "gantt",
  "title": "Gantt",
  "description": "Gantt chart with virtual scrolling, drag and drop, dependencies and zoom. Built on the headless ganttkit core.",
  "dependencies": [
    "ganttkit@^0.3.1"
  ],
  "files": [
    {
      "path": "registry/gantt/Gantt.vue",
      "content": "<script setup lang=\"ts\" generic=\"R extends GanttRowBase, I extends GanttItemBase = R & GanttItemBase\">\nimport {\n  type DateInput,\n  type GanttBarState,\n  type GanttEditable,\n  type GanttItemBase,\n  type GanttLink,\n  type GanttRowBase,\n  type GanttRowState,\n  type ItemChange,\n  type SpanDescription,\n  type SnapUnit,\n  type WorkingCalendar,\n  type ZoomLevel,\n  useGantt,\n} from 'ganttkit'\nimport { type HTMLAttributes, computed, provide, ref, useId, useSlots } from 'vue'\nimport { cn } from '@/lib/utils'\nimport { type GanttContext, GanttContextKey, type GanttMenuState } from './context'\nimport GanttBar from './GanttBar.vue'\nimport GanttExpandToggle from './GanttExpandToggle.vue'\nimport GanttGrid from './GanttGrid.vue'\nimport GanttLinks from './GanttLinks.vue'\nimport GanttMenu from './GanttMenu.vue'\nimport GanttRowLabel from './GanttRowLabel.vue'\nimport GanttTimescale from './GanttTimescale.vue'\nimport GanttToday from './GanttToday.vue'\nimport GanttTooltip from './GanttTooltip.vue'\n\nconst props = withDefaults(\n  defineProps<{\n    rows: readonly R[]\n    /** Omit for \"one task per row\": rows with `start` and `end` become bars. */\n    items?: readonly I[]\n    links?: readonly GanttLink[]\n    timeZone?: string\n    locale?: string\n    rowHeight?: number\n    sidebarWidth?: number\n    editable?: boolean | Partial<GanttEditable>\n    isItemEditable?: (item: I) => boolean\n    /** Working days and holidays: edits keep lengths in working days and skip days off. */\n    calendar?: WorkingCalendar\n    snap?: SnapUnit\n    /** Overlapping items stack into lanes and the row grows. */\n    stackOverlaps?: boolean\n    /** Items a row can run at once before it is shaded as overloaded. Default 1. */\n    getRowCapacity?: (row: R) => number\n    /** Rows an item may be dragged to, e.g. not group headers. */\n    canMoveToRow?: (item: I, row: R) => boolean\n    /** Push successors forward after an edit so their links hold again. */\n    autoShift?: boolean\n    /** Dates and duration on hover, and the new ones while dragging. */\n    tooltip?: boolean\n    /** Right-click menu on bars with \"Move to\" another row and your own `menu` slot actions. */\n    contextMenu?: boolean\n    range?: { start: DateInput; end: DateInput }\n    weekStartsOn?: number\n    /** Date centered when the chart first gets a size. Defaults to today, `null` keeps the start. */\n    initialDate?: DateInput | null\n    class?: HTMLAttributes['class']\n  }>(),\n  { rowHeight: 36, sidebarWidth: 280, editable: true, stackOverlaps: true, autoShift: false, tooltip: true, contextMenu: true },\n)\n\nconst zoom = defineModel<ZoomLevel>('zoom', { default: 'week' })\n\nconst emit = defineEmits<{\n  'update:rows': [rows: R[]]\n  'update:items': [items: I[]]\n  'update:links': [links: GanttLink[]]\n  'item-change': [change: ItemChange<I>]\n  /** All changes of one edit: the edited item, then the successors `autoShift` moved. */\n  'items-change': [changes: ItemChange<I>[]]\n  'item-click': [item: I]\n  'link-create': [link: GanttLink]\n  'link-delete': [link: GanttLink]\n}>()\n\ndefineSlots<{\n  'sidebar-header'?: () => unknown\n  row?: (props: GanttRowState<R>) => unknown\n  bar?: (props: GanttBarState<I>) => unknown\n  tooltip?: (props: { bar: GanttBarState<I>; description: SpanDescription; movingTo: R | null }) => unknown\n  menu?: (props: { item: I; close: () => void }) => unknown\n  timeline?: () => unknown\n}>()\n\nconst HEADER_HEIGHT = 56\n\nconst gantt = useGantt<R, I>({\n  rows: () => props.rows,\n  items: () => props.items,\n  links: () => props.links,\n  timeZone: () => props.timeZone,\n  locale: () => props.locale,\n  zoom,\n  rowHeight: () => props.rowHeight,\n  sidebarWidth: () => props.sidebarWidth,\n  headerHeight: HEADER_HEIGHT,\n  editable: () => props.editable,\n  isItemEditable: props.isItemEditable,\n  calendar: () => props.calendar,\n  snap: () => props.snap,\n  stackOverlaps: () => props.stackOverlaps,\n  getRowCapacity: props.getRowCapacity,\n  canMoveToRow: props.canMoveToRow,\n  autoShift: () => props.autoShift,\n  range: () => props.range,\n  weekStartsOn: props.weekStartsOn,\n  initialDate: () => props.initialDate,\n  onItemsChange(changes) {\n    for (const change of changes) emit('item-change', change)\n    emit('items-change', changes)\n    const byItem = new Map<unknown, ItemChange<I>>(changes.map((change) => [change.item, change]))\n    const replace = <T,>(list: readonly T[]) =>\n      list.map((entry) => {\n        const change = byItem.get(entry)\n        if (!change) return entry\n        return { ...entry, start: change.start, end: change.end, ...(change.rowId !== undefined && { rowId: change.rowId }) }\n      })\n    if (props.items) emit('update:items', replace(props.items))\n    else emit('update:rows', replace(props.rows))\n  },\n  onLinkCreate(draft) {\n    const link: GanttLink = { id: `${draft.from}:${draft.to}`, ...draft }\n    emit('link-create', link)\n    emit('update:links', [...(props.links ?? []), link])\n  },\n})\n\nconst hoveredRowId = ref<string | null>(null)\nconst hoveredItemId = ref<string | null>(null)\nconst menu = ref<GanttMenuState | null>(null)\nconst slots = useSlots()\nconst menuEnabled = computed(() => props.contextMenu && (gantt.canReassign.value || !!slots.menu))\nconst selectedItemId = ref<string | null>(null)\nconst selectedLinkId = ref<string | null>(null)\n\nprovide(GanttContextKey, {\n  ...(gantt as unknown as GanttContext),\n  uid: useId(),\n  hoveredRowId,\n  hoveredItemId,\n  menu,\n  menuEnabled,\n  openMenu: (itemId: string, x: number, y: number) => {\n    hoveredItemId.value = null\n    menu.value = { itemId, x, y }\n  },\n  closeMenu: () => (menu.value = null),\n  selectedItemId,\n  selectedLinkId,\n})\n\nconst { viewportEl, totalWidth, totalHeight, visibleRows, visibleBars } = gantt\n\nfunction zoomAt(clientX: number, direction: 'in' | 'out') {\n  const box = viewportEl.value!.getBoundingClientRect()\n  const anchor = clientX - box.left - props.sidebarWidth\n  if (direction === 'in') gantt.zoomIn(anchor)\n  else gantt.zoomOut(anchor)\n}\n\n// Ctrl/Cmd + wheel (and trackpad pinch in Chrome and Firefox) zooms around the pointer.\nlet wheelDelta = 0\nfunction onWheel(event: WheelEvent) {\n  if (!event.ctrlKey && !event.metaKey) return\n  event.preventDefault()\n  // Firefox reports mouse wheels in lines, not pixels.\n  const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? viewportEl.value!.clientHeight : 1\n  wheelDelta += event.deltaY * unit\n  if (Math.abs(wheelDelta) < 40) return\n  zoomAt(event.clientX, wheelDelta < 0 ? 'in' : 'out')\n  wheelDelta = 0\n}\n\n// Safari sends trackpad pinch as gesture events, without them it zooms the whole page.\nlet gestureScale = 1\nfunction onGestureStart(event: Event) {\n  event.preventDefault()\n  gestureScale = 1\n}\nfunction onGestureChange(event: Event) {\n  event.preventDefault()\n  const { scale, clientX } = event as Event & { scale: number; clientX: number }\n  if (scale / gestureScale > 1.25) {\n    zoomAt(clientX, 'in')\n    gestureScale = scale\n  } else if (scale / gestureScale < 0.8) {\n    zoomAt(clientX, 'out')\n    gestureScale = scale\n  }\n}\n\nfunction onKeydown(event: KeyboardEvent) {\n  if ((event.key === 'Delete' || event.key === 'Backspace') && selectedLinkId.value && props.links) {\n    const link = props.links.find((l) => String(l.id) === selectedLinkId.value)\n    if (!link) return\n    event.preventDefault()\n    selectedLinkId.value = null\n    emit('link-delete', link)\n    emit('update:links', props.links.filter((l) => l !== link))\n  }\n}\n\nfunction onBarClick(bar: GanttBarState<I>) {\n  selectedItemId.value = bar.id\n  selectedLinkId.value = null\n  emit('item-click', bar.item)\n}\n\ndefineExpose({ gantt })\n</script>\n\n<template>\n  <div\n    ref=\"viewportEl\"\n    data-slot=\"gantt\"\n    :class=\"cn('relative overflow-auto overscroll-contain bg-background text-sm text-foreground', props.class)\"\n    tabindex=\"-1\"\n    @wheel=\"onWheel\"\n    @gesturestart=\"onGestureStart\"\n    @gesturechange=\"onGestureChange\"\n    @keydown=\"onKeydown\"\n  >\n    <div\n      class=\"relative\"\n      :style=\"{ width: `${sidebarWidth + totalWidth}px`, height: `${HEADER_HEIGHT + totalHeight}px` }\"\n    >\n      <div class=\"sticky top-0 z-30 flex border-b bg-background\" :style=\"{ height: `${HEADER_HEIGHT}px` }\">\n        <div\n          class=\"sticky left-0 z-10 flex shrink-0 items-end border-r bg-background\"\n          :style=\"{ width: `${sidebarWidth}px` }\"\n        >\n          <slot name=\"sidebar-header\">\n            <div class=\"flex items-center gap-1 pb-1.5 pl-2 text-xs font-medium text-muted-foreground\">\n              <GanttExpandToggle />\n              Name\n            </div>\n          </slot>\n        </div>\n        <GanttTimescale class=\"shrink-0\" :style=\"{ width: `${totalWidth}px` }\" />\n      </div>\n\n      <div class=\"flex\">\n        <div\n          class=\"sticky left-0 z-20 shrink-0 border-r bg-background\"\n          :style=\"{ width: `${sidebarWidth}px`, height: `${totalHeight}px` }\"\n        >\n          <div\n            v-for=\"row in visibleRows\"\n            :key=\"row.id\"\n            class=\"absolute inset-x-0 top-0 border-b border-border/60\"\n            :class=\"hoveredRowId === row.id && 'bg-muted/50'\"\n            :style=\"{ height: `${row.height}px`, transform: `translateY(${row.top}px)` }\"\n            @mouseenter=\"hoveredRowId = row.id\"\n            @mouseleave=\"hoveredRowId = null\"\n          >\n            <slot name=\"row\" v-bind=\"row\">\n              <GanttRowLabel :row=\"row\" />\n            </slot>\n          </div>\n        </div>\n\n        <div class=\"relative shrink-0 overflow-hidden\" :style=\"{ width: `${totalWidth}px`, height: `${totalHeight}px` }\">\n          <GanttGrid />\n          <slot name=\"timeline\" />\n          <GanttToday />\n          <GanttLinks />\n          <GanttBar\n            v-for=\"bar in visibleBars\"\n            :key=\"bar.id\"\n            :bar=\"bar\"\n            @select=\"onBarClick(bar)\"\n          >\n            <template v-if=\"$slots.bar\" #default>\n              <slot name=\"bar\" v-bind=\"bar\" />\n            </template>\n          </GanttBar>\n        </div>\n      </div>\n    </div>\n\n    <GanttMenu v-if=\"menuEnabled\">\n      <template v-if=\"$slots.menu\" #default=\"slotProps\">\n        <slot name=\"menu\" v-bind=\"slotProps as any\" />\n      </template>\n    </GanttMenu>\n\n    <GanttTooltip v-if=\"tooltip && !menu\">\n      <template v-if=\"$slots.tooltip\" #default=\"slotProps\">\n        <slot name=\"tooltip\" v-bind=\"slotProps as any\" />\n      </template>\n    </GanttTooltip>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/GanttBar.vue",
      "content": "<script setup lang=\"ts\">\nimport type { GanttBarState, GanttItemBase } from 'ganttkit'\nimport { computed, nextTick, useTemplateRef } from 'vue'\nimport { cn } from '@/lib/utils'\nimport { useGanttContext } from './context'\n\ntype BarItem = GanttItemBase & {\n  name?: string\n  title?: string\n  progress?: number\n  color?: string\n  type?: string\n}\n\nconst props = defineProps<{ bar: GanttBarState<BarItem> }>()\nconst emit = defineEmits<{ select: [] }>()\n\nconst { startDrag, startLink, nudge, moveToRow, editable, selectedItemId, hoveredItemId, menuEnabled, openMenu } =\n  useGanttContext()\n\nconst root = useTemplateRef<HTMLElement>('root')\nconst item = computed(() => props.bar.item)\nconst label = computed(() => item.value.name ?? item.value.title ?? '')\nconst summary = computed(() => item.value.type === 'summary')\nconst progress = computed(() => Math.min(1, Math.max(0, item.value.progress ?? 0)))\nconst selected = computed(() => selectedItemId.value === props.bar.id)\n// Narrow bars show their label outside, to the right, when it fits before the next bar.\nconst narrow = computed(() => props.bar.milestone || props.bar.width < 56)\nconst labelOutside = computed(() => narrow.value && props.bar.room > 24 + label.value.length * 7)\nconst canMove = computed(() => props.bar.editable && editable.value.move)\nconst canResize = computed(() => props.bar.editable && editable.value.resize && !props.bar.milestone)\nconst canLink = computed(() => props.bar.editable && editable.value.link)\n\nfunction onContextMenu(event: MouseEvent) {\n  if (!menuEnabled.value) return\n  event.preventDefault()\n  selectedItemId.value = props.bar.id\n  openMenu(props.bar.id, event.clientX, event.clientY)\n}\n\nfunction onKeydown(event: KeyboardEvent) {\n  const steps = event.key === 'ArrowLeft' ? -1 : event.key === 'ArrowRight' ? 1 : 0\n  const rows = event.altKey ? (event.key === 'ArrowUp' ? -1 : event.key === 'ArrowDown' ? 1 : 0) : 0\n  if (rows) {\n    event.preventDefault()\n    moveToRow(props.bar.id, rows)\n    // Moving to another row reorders the bars, and a moved DOM node loses focus.\n    void nextTick(() => root.value?.focus())\n  } else if (steps) {\n    event.preventDefault()\n    nudge(props.bar.id, event.shiftKey ? 'resize-end' : 'move', steps)\n  } else if (menuEnabled.value && (event.key === 'ContextMenu' || (event.shiftKey && event.key === 'F10'))) {\n    event.preventDefault()\n    const box = root.value!.getBoundingClientRect()\n    openMenu(props.bar.id, box.left, box.bottom + 4)\n  } else if (event.key === 'Enter' || event.key === ' ') {\n    event.preventDefault()\n    emit('select')\n  }\n}\n</script>\n\n<template>\n  <div\n    ref=\"root\"\n    :data-gantt-item=\"bar.id\"\n    role=\"button\"\n    tabindex=\"0\"\n    :aria-label=\"label\"\n    :aria-pressed=\"selected\"\n    :class=\"\n      cn(\n        'group absolute top-0 left-0 touch-none outline-none select-none',\n        canMove && 'cursor-grab',\n        bar.dragging && 'z-10 cursor-grabbing',\n      )\n    \"\n    :style=\"{\n      width: `${bar.width}px`,\n      height: `${bar.height}px`,\n      transform: `translate(${bar.x}px, ${bar.y}px)`,\n      '--gantt-bar': item.color ?? 'var(--primary)',\n    }\"\n    @pointerdown=\"startDrag($event, bar.id, 'move')\"\n    @pointerenter=\"hoveredItemId = bar.id\"\n    @pointerleave=\"hoveredItemId === bar.id && (hoveredItemId = null)\"\n    @focus=\"($event.target as HTMLElement).matches(':focus-visible') && (hoveredItemId = bar.id)\"\n    @blur=\"hoveredItemId === bar.id && (hoveredItemId = null)\"\n    @click=\"emit('select')\"\n    @contextmenu=\"onContextMenu\"\n    @keydown=\"onKeydown\"\n  >\n    <div\n      v-if=\"bar.milestone\"\n      class=\"size-full scale-[0.72] rotate-45 rounded-[3px] bg-(--gantt-bar) group-focus-visible:ring-2 group-focus-visible:ring-ring\"\n      :class=\"selected && 'ring-2 ring-ring ring-offset-1 ring-offset-background'\"\n    />\n    <div\n      v-else-if=\"summary\"\n      class=\"absolute inset-x-0 top-1/2 h-2 -translate-y-1/2 rounded-[2px] bg-foreground/70\"\n    />\n    <!-- A tint of the bar color, the done part of it a stronger tint. The color is the theme's primary or item.color. -->\n    <div\n      v-else\n      :class=\"\n        cn(\n          'relative flex size-full items-center overflow-hidden rounded-md border text-xs transition-shadow',\n          'border-[color-mix(in_oklab,var(--gantt-bar)_35%,transparent)] bg-[color-mix(in_oklab,var(--gantt-bar)_16%,var(--background))]',\n          'text-[color-mix(in_oklab,var(--gantt-bar)_55%,var(--foreground))]',\n          'group-hover:border-[color-mix(in_oklab,var(--gantt-bar)_60%,transparent)]',\n          'group-focus-visible:ring-2 group-focus-visible:ring-ring group-focus-visible:ring-offset-1 group-focus-visible:ring-offset-background',\n          selected && 'ring-2 ring-ring ring-offset-1 ring-offset-background',\n          bar.dragging && 'shadow-lg',\n        )\n      \"\n    >\n      <div\n        v-if=\"progress > 0\"\n        class=\"absolute inset-y-0 left-0 bg-[color-mix(in_oklab,var(--gantt-bar)_38%,var(--background))]\"\n        :style=\"{ width: `${progress * 100}%` }\"\n      />\n      <span v-if=\"!narrow\" class=\"relative flex min-w-0 flex-1 items-center gap-1.5 px-2\">\n        <slot><span class=\"truncate\">{{ label }}</span></slot>\n      </span>\n    </div>\n\n    <!-- Offset past the link elbow (12px), so outgoing links do not cross the label. -->\n    <span\n      v-if=\"labelOutside && label\"\n      class=\"pointer-events-none absolute top-1/2 left-full ml-5 flex -translate-y-1/2 items-center gap-1.5 text-xs whitespace-nowrap text-muted-foreground\"\n      :class=\"summary && 'font-medium text-foreground'\"\n    >\n      <slot>{{ label }}</slot>\n    </span>\n\n    <template v-if=\"canResize\">\n      <div\n        class=\"absolute inset-y-0 left-0 w-2 cursor-ew-resize\"\n        @pointerdown=\"startDrag($event, bar.id, 'resize-start')\"\n      />\n      <div\n        class=\"absolute inset-y-0 right-0 w-2 cursor-ew-resize\"\n        @pointerdown=\"startDrag($event, bar.id, 'resize-end')\"\n      />\n    </template>\n\n    <template v-if=\"canLink && !bar.dragging\">\n      <button\n        v-for=\"side in ['start', 'end'] as const\"\n        :key=\"side\"\n        type=\"button\"\n        tabindex=\"-1\"\n        :aria-label=\"side === 'start' ? 'Link from start' : 'Link from end'\"\n        :class=\"\n          cn(\n            'absolute top-1/2 size-3 -translate-y-1/2 cursor-crosshair rounded-full border-2 border-(--gantt-bar) bg-background opacity-0 transition-opacity group-hover:opacity-100',\n            side === 'start' ? '-left-4' : '-right-4',\n          )\n        \"\n        @pointerdown=\"startLink($event, bar.id, side)\"\n      />\n    </template>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/GanttGrid.vue",
      "content": "<script setup lang=\"ts\">\nimport { useGanttContext } from './context'\n\nconst { ticks, nonWorkingDays, visibleRows, windowRect, hoveredRowId } = useGanttContext()\n</script>\n\n<template>\n  <div class=\"pointer-events-none absolute inset-0\" aria-hidden=\"true\">\n    <div\n      v-for=\"day in nonWorkingDays\"\n      :key=\"day.key\"\n      class=\"absolute bg-muted/50\"\n      :style=\"{ left: `${day.x}px`, width: `${day.width}px`, top: `${windowRect.y}px`, height: `${windowRect.height}px` }\"\n    />\n    <div\n      v-for=\"tick in ticks.bottom\"\n      :key=\"tick.key\"\n      class=\"absolute w-px bg-border/60\"\n      :style=\"{ left: `${tick.x}px`, top: `${windowRect.y}px`, height: `${windowRect.height}px` }\"\n    />\n  </div>\n  <div\n    v-for=\"row in visibleRows\"\n    :key=\"row.id\"\n    class=\"absolute border-b border-border/60\"\n    :class=\"hoveredRowId === row.id && 'bg-muted/50'\"\n    :style=\"{\n      left: `${windowRect.x}px`,\n      width: `${windowRect.width}px`,\n      height: `${row.height}px`,\n      transform: `translateY(${row.top}px)`,\n    }\"\n    @mouseenter=\"hoveredRowId = row.id\"\n    @mouseleave=\"hoveredRowId = null\"\n  >\n    <!-- More work at once than the row can take. -->\n    <div\n      v-for=\"span in row.overloads\"\n      :key=\"span.start\"\n      data-gantt-overload\n      class=\"pointer-events-none absolute inset-y-0 border-b-2 border-destructive/60 bg-destructive/10\"\n      :style=\"{ left: `${span.x - windowRect.x}px`, width: `${span.width}px` }\"\n    />\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/GanttLinks.vue",
      "content": "<script setup lang=\"ts\">\nimport { useGanttContext } from './context'\n\nconst { visibleLinks, linkDraft, windowRect, uid, selectedLinkId, selectedItemId } = useGanttContext()\n\nconst marker = (state: 'default' | 'violated' | 'selected') => `${uid}-arrow-${state}`\n\nfunction select(id: string) {\n  selectedLinkId.value = id\n  selectedItemId.value = null\n}\n</script>\n\n<template>\n  <!-- The SVG only covers the rendered window, paths use timeline coordinates via viewBox. -->\n  <svg\n    class=\"pointer-events-none absolute overflow-visible\"\n    :style=\"{\n      left: `${windowRect.x}px`,\n      top: `${windowRect.y}px`,\n      width: `${windowRect.width}px`,\n      height: `${windowRect.height}px`,\n    }\"\n    :viewBox=\"`${windowRect.x} ${windowRect.y} ${windowRect.width || 1} ${windowRect.height || 1}`\"\n  >\n    <defs>\n      <marker\n        v-for=\"state in ['default', 'violated', 'selected'] as const\"\n        :id=\"marker(state)\"\n        :key=\"state\"\n        viewBox=\"0 0 8 8\"\n        refX=\"7\"\n        refY=\"4\"\n        markerWidth=\"8\"\n        markerHeight=\"8\"\n        markerUnits=\"userSpaceOnUse\"\n        orient=\"auto\"\n      >\n        <path\n          d=\"M0,0 L8,4 L0,8 z\"\n          :class=\"{\n            'fill-muted-foreground': state === 'default',\n            'fill-destructive': state === 'violated',\n            'fill-primary': state === 'selected',\n          }\"\n        />\n      </marker>\n    </defs>\n\n    <g\n      v-for=\"link in visibleLinks\"\n      :key=\"link.id\"\n      class=\"pointer-events-auto cursor-pointer\"\n      @click.stop=\"select(link.id)\"\n    >\n      <path :d=\"link.path\" class=\"fill-none stroke-transparent\" stroke-width=\"10\" />\n      <path\n        :d=\"link.path\"\n        class=\"fill-none\"\n        :class=\"\n          selectedLinkId === link.id\n            ? 'stroke-primary'\n            : link.violated\n              ? 'stroke-destructive'\n              : 'stroke-muted-foreground/70'\n        \"\n        :stroke-width=\"selectedLinkId === link.id ? 2 : 1.25\"\n        :marker-end=\"`url(#${marker(selectedLinkId === link.id ? 'selected' : link.violated ? 'violated' : 'default')})`\"\n      />\n    </g>\n\n    <line\n      v-if=\"linkDraft\"\n      :x1=\"linkDraft.x1\"\n      :y1=\"linkDraft.y1\"\n      :x2=\"linkDraft.x2\"\n      :y2=\"linkDraft.y2\"\n      class=\"stroke-primary\"\n      stroke-width=\"1.5\"\n      stroke-dasharray=\"4 3\"\n    />\n  </svg>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/GanttRowLabel.vue",
      "content": "<script setup lang=\"ts\">\nimport type { GanttRowState } from 'ganttkit'\nimport { computed } from 'vue'\nimport { useGanttContext } from './context'\n\nconst props = defineProps<{ row: GanttRowState<{ id: string | number; name?: string; title?: string }> }>()\n\nconst { toggleRow, rowHeight } = useGanttContext()\n\nconst label = computed(() => props.row.row.name ?? props.row.row.title ?? String(props.row.row.id))\n</script>\n\n<template>\n  <!-- One base row tall, so the name lines up with the first lane when the row grows. -->\n  <div class=\"flex items-center gap-1 pr-3\" :style=\"{ height: `${rowHeight}px`, paddingLeft: `${8 + row.depth * 16}px` }\">\n    <button\n      v-if=\"row.hasChildren\"\n      type=\"button\"\n      class=\"flex size-5 shrink-0 items-center justify-center rounded-sm text-muted-foreground hover:bg-accent hover:text-accent-foreground\"\n      :aria-label=\"row.expanded ? 'Collapse' : 'Expand'\"\n      :aria-expanded=\"row.expanded\"\n      @click=\"toggleRow(row.id)\"\n    >\n      <svg\n        class=\"size-3.5 transition-transform\"\n        :class=\"row.expanded && 'rotate-90'\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n      >\n        <path d=\"m9 18 6-6-6-6\" />\n      </svg>\n    </button>\n    <span v-else class=\"w-5 shrink-0\" />\n    <span class=\"truncate\" :class=\"row.hasChildren && 'font-medium'\">{{ label }}</span>\n    <span\n      v-if=\"row.overloads.length\"\n      class=\"ml-auto size-2 shrink-0 rounded-full bg-destructive\"\n      role=\"img\"\n      aria-label=\"Overloaded\"\n      title=\"Overloaded: more work at once than this row can take\"\n    />\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/GanttTimescale.vue",
      "content": "<script setup lang=\"ts\">\nimport { useGanttContext } from './context'\n\nconst { ticks, sidebarWidth } = useGanttContext()\n</script>\n\n<template>\n  <div class=\"relative select-none text-xs\">\n    <div class=\"absolute inset-x-0 top-0 h-1/2 border-b\">\n      <div\n        v-for=\"tick in ticks.top\"\n        :key=\"tick.key\"\n        class=\"absolute inset-y-0 border-l\"\n        :style=\"{ left: `${tick.x}px`, width: `${tick.width}px` }\"\n      >\n        <!-- Sticky label: the current month stays readable while scrolling through it. -->\n        <span\n          class=\"sticky inline-block truncate px-2 leading-7 font-medium\"\n          :style=\"{ left: `${sidebarWidth}px`, maxWidth: `${tick.width}px` }\"\n        >\n          {{ tick.label }}\n        </span>\n      </div>\n    </div>\n    <div class=\"absolute inset-x-0 bottom-0 h-1/2\">\n      <div\n        v-for=\"tick in ticks.bottom\"\n        :key=\"tick.key\"\n        class=\"absolute inset-y-0 flex items-center justify-center gap-1 overflow-hidden border-l text-muted-foreground\"\n        :class=\"tick.nonWorking && 'text-muted-foreground/60'\"\n        :style=\"{ left: `${tick.x}px`, width: `${tick.width}px` }\"\n      >\n        <span v-if=\"tick.sublabel\" class=\"text-[10px] uppercase opacity-70\">{{ tick.sublabel }}</span>\n        <span class=\"truncate\">{{ tick.label }}</span>\n      </div>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/GanttToday.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from 'vue'\nimport { useGanttContext } from './context'\n\nconst { timeToX, totalWidth, windowRect } = useGanttContext()\n\nconst x = computed(() => timeToX(Date.now()))\n</script>\n\n<template>\n  <div\n    v-if=\"x >= 0 && x <= totalWidth\"\n    class=\"pointer-events-none absolute w-px bg-primary/50\"\n    :style=\"{ left: `${x}px`, top: `${windowRect.y}px`, height: `${windowRect.height}px` }\"\n    aria-hidden=\"true\"\n  />\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/GanttTooltip.vue",
      "content": "<script setup lang=\"ts\">\nimport { type GanttBarState, type GanttItemBase, type SpanDescription, describeSpan } from 'ganttkit'\nimport { computed, onBeforeUnmount, ref, watch } from 'vue'\nimport { useGanttContext } from './context'\n\ntype TooltipItem = GanttItemBase & { name?: string; title?: string; progress?: number }\ntype TooltipRow = { id: string | number; name?: string; title?: string }\n\nconst props = withDefaults(defineProps<{ delay?: number }>(), { delay: 400 })\n\ndefineSlots<{\n  default?: (props: { bar: GanttBarState<TooltipItem>; description: SpanDescription; movingTo: TooltipRow | null }) => unknown\n}>()\n\nconst {\n  uid,\n  visibleBars,\n  flatRows,\n  draft,\n  viewportEl,\n  scrollLeft,\n  scrollTop,\n  sidebarWidth,\n  headerHeight,\n  timeZone,\n  locale,\n  calendar,\n  hoveredItemId,\n} = useGanttContext()\n\n// Hovering waits a moment so the tooltip does not flash while the pointer crosses the chart.\nconst shownId = ref<string | null>(null)\nlet timer: ReturnType<typeof setTimeout> | undefined\nwatch(hoveredItemId, (id) => {\n  clearTimeout(timer)\n  if (!id) shownId.value = null\n  else timer = setTimeout(() => (shownId.value = id), props.delay)\n})\nonBeforeUnmount(() => clearTimeout(timer))\n\n/** While dragging, the tooltip follows the dragged bar and shows the dates it will get. */\nconst bar = computed(() => {\n  const id = draft.value?.id ?? shownId.value\n  return id ? (visibleBars.value.find((b) => b.id === id) as GanttBarState<TooltipItem> | undefined) : undefined\n})\n\nconst description = computed(() =>\n  bar.value\n    ? describeSpan(bar.value.start, bar.value.end, { timeZone: timeZone.value, locale: locale.value, calendar: calendar.value })\n    : null,\n)\n\nconst movingTo = computed<TooltipRow | null>(() => {\n  const active = draft.value\n  if (!active || active.rowId === active.fromRowId) return null\n  return (flatRows.value.find((row) => row.id === active.rowId)?.row as TooltipRow | undefined) ?? null\n})\n\nconst position = computed(() => {\n  const b = bar.value\n  const el = viewportEl.value\n  if (!b || !el) return null\n  const box = el.getBoundingClientRect()\n  const bodyTop = box.top + headerHeight.value\n  const bodyLeft = box.left + sidebarWidth.value\n  const left = bodyLeft + b.x - scrollLeft.value\n  const top = bodyTop + b.y - scrollTop.value\n  // Scrolled out of the body: nothing to point at.\n  if (top + b.height < bodyTop || top > box.bottom || left + b.width < bodyLeft || left > box.right) return null\n  const x = Math.min(Math.max(left, bodyLeft + 4), box.right - 8)\n  const above = top - 76 > 0\n  return { x, y: above ? top - 6 : top + b.height + 6, above }\n})\n\nconst label = (row: { name?: string; title?: string; id: string | number }) => row.name ?? row.title ?? String(row.id)\n</script>\n\n<template>\n  <Teleport to=\"body\">\n    <div\n      v-if=\"bar && description && position\"\n      :id=\"`${uid}-tooltip`\"\n      role=\"tooltip\"\n      data-slot=\"gantt-tooltip\"\n      class=\"pointer-events-none fixed z-50 max-w-72 rounded-md border bg-popover px-3 py-2 text-xs text-popover-foreground shadow-md\"\n      :style=\"{\n        left: `${position.x}px`,\n        top: `${position.y}px`,\n        transform: position.above ? 'translateY(-100%)' : undefined,\n      }\"\n    >\n      <slot :bar=\"bar\" :description=\"description\" :moving-to=\"movingTo\">\n        <div v-if=\"label(bar.item)\" class=\"truncate font-medium\">{{ label(bar.item) }}</div>\n        <div class=\"text-muted-foreground tabular-nums\">\n          {{ description.dates }}<template v-if=\"description.duration\">, {{ description.duration }}</template>\n        </div>\n        <div v-if=\"bar.item.progress\" class=\"text-muted-foreground tabular-nums\">\n          {{ Math.round(bar.item.progress * 100) }}% done\n        </div>\n        <div v-if=\"movingTo\" class=\"mt-1 font-medium text-primary\">Moves to {{ label(movingTo) }}</div>\n      </slot>\n    </div>\n  </Teleport>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/GanttMenu.vue",
      "content": "<script setup lang=\"ts\">\nimport { type MoveTarget, describeSpan } from 'ganttkit'\nimport { computed, nextTick, onBeforeUnmount, ref, useTemplateRef, watch } from 'vue'\nimport { cn } from '@/lib/utils'\nimport { useGanttContext } from './context'\n\ntype MenuRow = { id: string | number; name?: string; title?: string }\ntype MenuItem = { id: string | number; name?: string; title?: string; start: unknown; end: unknown }\n\nconst props = withDefaults(defineProps<{ searchPlaceholder?: string }>(), { searchPlaceholder: 'Search' })\n\ndefineSlots<{\n  /** Your own actions above \"Move to\", e.g. edit or delete. */\n  default?: (props: { item: MenuItem; close: () => void }) => unknown\n}>()\n\nconst {\n  uid,\n  menu,\n  closeMenu,\n  canReassign,\n  moveTargets,\n  moveItemToRow,\n  visibleBars,\n  scrollLeft,\n  scrollTop,\n  timeZone,\n  locale,\n  calendar,\n} = useGanttContext()\n\nconst SHOWN = 100\nconst label = (row: MenuRow) => row.name ?? row.title ?? String(row.id)\n\nconst el = useTemplateRef<HTMLElement>('el')\nconst input = useTemplateRef<HTMLInputElement>('input')\nconst list = useTemplateRef<HTMLElement>('list')\nconst query = ref('')\nconst active = ref(0)\nconst position = ref({ x: 0, y: 0 })\n\n// Targets are read once per opening: the list does not change while the menu is open.\nconst targets = ref<MoveTarget<MenuRow>[]>([])\nconst bar = computed(() => (menu.value ? visibleBars.value.find((b) => b.id === menu.value!.itemId) : undefined))\nconst item = computed(() => bar.value?.item as MenuItem | undefined)\nconst dates = computed(() =>\n  bar.value\n    ? describeSpan(bar.value.start, bar.value.end, { timeZone: timeZone.value, locale: locale.value, calendar: calendar.value }).dates\n    : '',\n)\n\n// Free rows first, so the answer to \"who can take this?\" is at the top.\nconst filtered = computed(() => {\n  const q = query.value.trim().toLowerCase()\n  const matches = q\n    ? targets.value.filter(\n        (t) => label(t.row).toLowerCase().includes(q) || (t.parent && label(t.parent).toLowerCase().includes(q)),\n      )\n    : targets.value\n  return [...matches.filter((t) => !t.busy), ...matches.filter((t) => t.busy)]\n})\nconst shown = computed(() => filtered.value.slice(0, SHOWN))\n\nwatch(menu, async (open) => {\n  query.value = ''\n  active.value = 0\n  if (!open) return\n  targets.value = canReassign.value ? (moveTargets(open.itemId) as MoveTarget<MenuRow>[]) : []\n  position.value = { x: open.x, y: open.y }\n  await nextTick()\n  // Keep the menu on screen: open up or to the left near the edges.\n  const box = el.value?.getBoundingClientRect()\n  if (box) {\n    position.value = {\n      x: Math.max(8, Math.min(open.x, innerWidth - box.width - 8)),\n      y: open.y + box.height > innerHeight - 8 ? Math.max(8, open.y - box.height) : open.y,\n    }\n  }\n  ;(input.value ?? el.value?.querySelector<HTMLElement>('button, [tabindex]'))?.focus()\n})\nwatch(query, () => (active.value = 0))\n\n// The menu points at a place on the chart, so scrolling the chart closes it.\nwatch([scrollLeft, scrollTop], () => close(false))\n\nfunction close(restoreFocus = true) {\n  const open = menu.value\n  if (!open) return\n  closeMenu()\n  if (restoreFocus) document.querySelector<HTMLElement>(`[data-gantt-item=\"${CSS.escape(open.itemId)}\"]`)?.focus()\n}\n\nfunction choose(target: MoveTarget<MenuRow>) {\n  const open = menu.value\n  if (!open) return\n  close(false)\n  moveItemToRow(open.itemId, target.row.id)\n  // The bar moves to another row and its DOM node with it, which drops focus: put it back.\n  void nextTick(() =>\n    document.querySelector<HTMLElement>(`[data-gantt-item=\"${CSS.escape(open.itemId)}\"]`)?.focus({ preventScroll: true }),\n  )\n}\n\nfunction onKeydown(event: KeyboardEvent) {\n  const count = shown.value.length\n  if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {\n    event.preventDefault()\n    if (!count) return\n    active.value = (active.value + (event.key === 'ArrowDown' ? 1 : -1) + count) % count\n    void nextTick(() => list.value?.querySelector(`[data-index=\"${active.value}\"]`)?.scrollIntoView({ block: 'nearest' }))\n  } else if (event.key === 'Enter') {\n    event.preventDefault()\n    const target = shown.value[active.value]\n    if (target) choose(target)\n  } else if (event.key === 'Escape' || event.key === 'Tab') {\n    event.preventDefault()\n    close()\n  }\n}\n\nfunction onPointerDownOutside(event: PointerEvent) {\n  if (menu.value && !el.value?.contains(event.target as Node)) close(false)\n}\nconst onResize = () => close(false)\naddEventListener('pointerdown', onPointerDownOutside, true)\naddEventListener('resize', onResize)\nonBeforeUnmount(() => {\n  removeEventListener('pointerdown', onPointerDownOutside, true)\n  removeEventListener('resize', onResize)\n})\n</script>\n\n<template>\n  <Teleport to=\"body\">\n    <div\n      v-if=\"menu && item\"\n      ref=\"el\"\n      role=\"dialog\"\n      :aria-label=\"`Actions for ${label(item)}`\"\n      data-slot=\"gantt-menu\"\n      class=\"fixed z-50 w-72 rounded-md border bg-popover p-1 text-sm text-popover-foreground shadow-md\"\n      :style=\"{ left: `${position.x}px`, top: `${position.y}px` }\"\n      @keydown=\"onKeydown\"\n      @contextmenu.prevent\n    >\n      <div class=\"px-2 pt-1.5 pb-2\">\n        <div class=\"truncate font-medium\">{{ label(item) }}</div>\n        <div class=\"text-xs text-muted-foreground tabular-nums\">{{ dates }}</div>\n      </div>\n\n      <slot :item=\"item\" :close=\"close\" />\n\n      <template v-if=\"canReassign\">\n        <div class=\"border-t px-2 pt-2 pb-1 text-xs font-medium text-muted-foreground\">Move to</div>\n        <div class=\"px-1 pb-1\">\n          <input\n            ref=\"input\"\n            v-model=\"query\"\n            type=\"text\"\n            role=\"combobox\"\n            aria-autocomplete=\"list\"\n            aria-expanded=\"true\"\n            :aria-controls=\"`${uid}-move-to`\"\n            :aria-activedescendant=\"shown.length ? `${uid}-move-to-${active}` : undefined\"\n            :placeholder=\"props.searchPlaceholder\"\n            class=\"h-8 w-full rounded-sm border bg-background px-2 text-sm outline-none placeholder:text-muted-foreground focus-visible:ring-2 focus-visible:ring-ring/50\"\n          >\n        </div>\n        <ul :id=\"`${uid}-move-to`\" ref=\"list\" role=\"listbox\" aria-label=\"Move to\" class=\"max-h-64 overflow-y-auto\">\n          <li\n            v-for=\"(target, index) in shown\"\n            :id=\"`${uid}-move-to-${index}`\"\n            :key=\"target.id\"\n            :data-index=\"index\"\n            role=\"option\"\n            :aria-selected=\"index === active\"\n            :class=\"\n              cn(\n                'flex cursor-pointer items-baseline gap-2 rounded-sm px-2 py-1.5',\n                index === active && 'bg-accent text-accent-foreground',\n              )\n            \"\n            @pointermove=\"active = index\"\n            @click=\"choose(target)\"\n          >\n            <span class=\"truncate\">{{ label(target.row) }}</span>\n            <span v-if=\"target.parent\" class=\"min-w-0 truncate text-xs text-muted-foreground\">{{ label(target.parent) }}</span>\n            <span v-if=\"target.busy\" class=\"ml-auto shrink-0 text-xs text-destructive\">Busy</span>\n          </li>\n          <li v-if=\"!shown.length\" class=\"px-2 py-1.5 text-muted-foreground\">No matches</li>\n          <li v-if=\"filtered.length > shown.length\" class=\"px-2 py-1.5 text-xs text-muted-foreground\">\n            {{ filtered.length - shown.length }} more, type to narrow down\n          </li>\n        </ul>\n      </template>\n    </div>\n  </Teleport>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/GanttExpandToggle.vue",
      "content": "<script setup lang=\"ts\">\nimport { useGanttContext } from './context'\n\nconst { allExpanded, hasNestedRows, expandAll, collapseAll } = useGanttContext()\n</script>\n\n<template>\n  <!-- Same size and place as the row chevrons, so it lines up with them. -->\n  <button\n    v-if=\"hasNestedRows\"\n    type=\"button\"\n    class=\"flex size-5 shrink-0 items-center justify-center rounded-sm text-muted-foreground hover:bg-accent hover:text-accent-foreground\"\n    :aria-label=\"allExpanded ? 'Collapse all' : 'Expand all'\"\n    :title=\"allExpanded ? 'Collapse all' : 'Expand all'\"\n    :aria-expanded=\"allExpanded\"\n    @click=\"allExpanded ? collapseAll() : expandAll()\"\n  >\n    <svg\n      class=\"size-3.5 transition-transform\"\n      :class=\"allExpanded && 'rotate-90'\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      aria-hidden=\"true\"\n    >\n      <path d=\"m9 18 6-6-6-6\" />\n    </svg>\n  </button>\n  <span v-else class=\"w-5 shrink-0\" />\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/context.ts",
      "content": "import type { GanttInstance } from 'ganttkit'\nimport { type ComputedRef, type InjectionKey, type Ref, inject } from 'vue'\n\nexport interface GanttMenuState {\n  itemId: string\n  /** Where to open, in client coordinates. */\n  x: number\n  y: number\n}\n\nexport interface GanttContext extends GanttInstance {\n  /** Prefix for SVG ids, unique per chart. */\n  uid: string\n  hoveredRowId: Ref<string | null>\n  /** Bar under the pointer or focused from the keyboard, drives the tooltip. */\n  hoveredItemId: Ref<string | null>\n  selectedItemId: Ref<string | null>\n  selectedLinkId: Ref<string | null>\n  /** Open context menu, `null` when closed. */\n  menu: Ref<GanttMenuState | null>\n  /** False when the menu would be empty, so the browser's own menu shows instead. */\n  menuEnabled: ComputedRef<boolean>\n  openMenu: (itemId: string, x: number, y: number) => void\n  closeMenu: () => void\n}\n\nexport const GanttContextKey: InjectionKey<GanttContext> = Symbol('GanttContext')\n\nexport function useGanttContext(): GanttContext {\n  const context = inject(GanttContextKey)\n  if (!context) throw new Error('Gantt parts must be used inside <Gantt>')\n  return context\n}\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/gantt/index.ts",
      "content": "export { default as Gantt } from './Gantt.vue'\nexport { default as GanttBar } from './GanttBar.vue'\nexport { default as GanttExpandToggle } from './GanttExpandToggle.vue'\nexport { default as GanttGrid } from './GanttGrid.vue'\nexport { default as GanttLinks } from './GanttLinks.vue'\nexport { default as GanttMenu } from './GanttMenu.vue'\nexport { default as GanttRowLabel } from './GanttRowLabel.vue'\nexport { default as GanttTimescale } from './GanttTimescale.vue'\nexport { default as GanttToday } from './GanttToday.vue'\nexport { default as GanttTooltip } from './GanttTooltip.vue'\nexport { type GanttContext, GanttContextKey, type GanttMenuState, useGanttContext } from './context'\n",
      "type": "registry:ui"
    }
  ],
  "type": "registry:ui"
}
